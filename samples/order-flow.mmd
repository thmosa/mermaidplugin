stateDiagram-v2
  %% Example for the guide: an order from cart to delivery
  direction LR
  [*] --> Cart
  Cart --> Checkout : check out
  Cart --> Abandoned : timeout
  Abandoned --> [*]
  Checkout --> Payment : pay
  state Payment {
    [*] --> Authorizing
    Authorizing --> Authorized : approved
    Authorizing --> Declined : declined
  }
  Declined --> Checkout : try again
  Authorized --> Fulfillment : ship
  state Fulfillment {
    [*] --> Picking
    Picking --> Packing
    Packing --> Shipped
  }
  Shipped --> Delivered : deliver
  Delivered --> Returned : return
  Returned --> Refunded
  Delivered --> [*]

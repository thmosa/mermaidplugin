{
  "name": "mermaid-tree",
  "displayName": "Mermaid Tree",
  "description": "Structure tree and live preview for Mermaid diagrams: hide, show and collapse parts of flowcharts, state, sequence and class diagrams.",
  "version": "0.7.1",
  "publisher": "SortaGameDev",
  "icon": "media/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "mermaid",
    "diagram",
    "flowchart",
    "state diagram",
    "sequence diagram",
    "class diagram",
    "preview",
    "uml"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:mermaid"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mermaid",
        "scopeName": "source.mermaid",
        "path": "./syntaxes/mermaid.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Mermaid Tree",
      "properties": {
        "mermaidTree.rememberHiddenState": {
          "type": "boolean",
          "default": false,
          "description": "Remember which elements are hidden or collapsed in each file after it is closed. When off, everything is shown each time a file is opened."
        },
        "mermaidTree.preview.theme": {
          "type": "string",
          "enum": [
            "auto",
            "default",
            "dark",
            "forest",
            "neutral",
            "base",
            "neo",
            "neo-dark",
            "redux",
            "redux-dark",
            "redux-color",
            "redux-dark-color"
          ],
          "enumDescriptions": [
            "Follow VS Code: light themes use Mermaid's default theme, dark themes use dark.",
            "Mermaid's default theme.",
            "Mermaid's dark theme.",
            "Mermaid's forest theme (greens).",
            "Mermaid's neutral theme (greys), good for printing.",
            "Mermaid's base theme, the one to use with Theme Variables.",
            "Mermaid's neo theme: outlined shapes with gradient borders. Made for the neo look.",
            "Mermaid's neo theme for dark backgrounds.",
            "Mermaid's redux theme.",
            "Mermaid's redux theme for dark backgrounds.",
            "Mermaid's redux theme with colors.",
            "Mermaid's redux theme with colors, for dark backgrounds."
          ],
          "default": "auto",
          "description": "Mermaid theme for the preview and export. The Theme menu in the preview can try another theme until this setting changes. A diagram's own %%{init}%% or front matter config still wins."
        },
        "mermaidTree.preview.themeVariables": {
          "type": "object",
          "default": {},
          "markdownDescription": "Mermaid theme variables for the preview, for example `{ \"primaryColor\": \"#ffcc00\", \"lineColor\": \"#888888\" }`. Works best with the theme `base`. See [Mermaid's theming](https://mermaid.js.org/config/theming.html) for all variables."
        },
        "mermaidTree.namingStyle": {
          "type": "string",
          "enum": [
            "off",
            "camelCase",
            "PascalCase",
            "snake_case"
          ],
          "enumDescriptions": [
            "No naming warnings.",
            "orderService, w6F2",
            "OrderService, W6F2",
            "order_service, w6_f2"
          ],
          "default": "off",
          "description": "Warn about names (nodes, states, participants, classes, groups) that do not follow this style, with a quick fix that renames every use."
        },
        "mermaidTree.checks.letterCase": {
          "type": "boolean",
          "default": true,
          "description": "Mark names that differ only in letter case, such as Order and order."
        },
        "mermaidTree.checks.similarNames": {
          "type": "boolean",
          "default": true,
          "description": "Warn about names that differ only in word separation, such as orderplanned and order_planned, with a quick fix that uses one of them everywhere."
        },
        "mermaidTree.checks.lookalikeLetters": {
          "type": "boolean",
          "default": true,
          "description": "Warn about names with Cyrillic, Greek or full-width letters that look like Latin ones, with a quick fix that uses Latin letters."
        },
        "mermaidTree.checks.sharedStates": {
          "type": "boolean",
          "default": true,
          "description": "Warn when the same state is used inside two composite states. Mermaid draws it as one state, in the last composite state that uses it. The quick fix gives it its own name in the other one."
        }
      }
    },
    "configurationDefaults": {
      "[mermaid]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.autoIndent": "full"
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mermaidTree",
          "title": "Mermaid Tree",
          "icon": "media/tree.svg"
        }
      ]
    },
    "views": {
      "mermaidTree": [
        {
          "id": "mermaidTree.structure",
          "name": "Mermaid Structure"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mermaidTree.structure",
        "contents": "Open a .mmd or .mermaid file to see the diagram structure.\n[Preview Diagram](command:mermaidTree.openPreview)"
      }
    ],
    "commands": [
      {
        "command": "mermaidTree.openPreview",
        "title": "Preview Diagram",
        "category": "Mermaid Tree",
        "icon": "$(open-preview)"
      },
      {
        "command": "mermaidTree.showTree",
        "title": "View Tree",
        "category": "Mermaid Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "mermaidTree.showAll",
        "title": "Show All",
        "category": "Mermaid Tree",
        "icon": "$(eye)"
      },
      {
        "command": "mermaidTree.search",
        "title": "Search Tree…",
        "category": "Mermaid Tree",
        "icon": "$(search)"
      },
      {
        "command": "mermaidTree.clearSearch",
        "title": "Clear Search",
        "category": "Mermaid Tree",
        "icon": "$(clear-all)"
      },
      {
        "command": "mermaidTree.fixNaming",
        "title": "Fix Naming",
        "category": "Mermaid Tree"
      },
      {
        "command": "mermaidTree.fixLookalike",
        "title": "Use Latin Letters",
        "category": "Mermaid Tree"
      },
      {
        "command": "mermaidTree.useName",
        "title": "Use Other Name",
        "category": "Mermaid Tree"
      },
      {
        "command": "mermaidTree.ownStateName",
        "title": "Give State Its Own Name Here",
        "category": "Mermaid Tree"
      },
      {
        "command": "mermaidTree.fixAllNaming",
        "title": "Fix All Naming Issues",
        "category": "Mermaid Tree"
      },
      {
        "command": "mermaidTree.changeParticipant",
        "title": "Change Participant…",
        "category": "Mermaid Tree"
      },
      {
        "command": "mermaidTree.showInDiagram",
        "title": "Show in Diagram",
        "category": "Mermaid Tree",
        "icon": "$(location)"
      },
      {
        "command": "mermaidTree.combineClassDiagrams",
        "title": "Combine Class Diagrams…",
        "category": "Mermaid Tree"
      },
      {
        "command": "mermaidTree.openSettings",
        "title": "Settings",
        "category": "Mermaid Tree",
        "icon": "$(gear)"
      },
      {
        "command": "mermaidTree.focusNeighbors",
        "title": "Focus",
        "category": "Mermaid Tree",
        "icon": "$(target)"
      },
      {
        "command": "mermaidTree.showClosest",
        "title": "Show Closest Objects",
        "category": "Mermaid Tree"
      },
      {
        "command": "mermaidTree.showChain",
        "title": "Custom Focus…",
        "category": "Mermaid Tree"
      },
      {
        "command": "mermaidTree.hideItem",
        "title": "Hide",
        "category": "Mermaid Tree",
        "icon": "$(eye-closed)"
      },
      {
        "command": "mermaidTree.collapseGroup",
        "title": "Collapse in Diagram",
        "category": "Mermaid Tree",
        "icon": "$(fold)"
      },
      {
        "command": "mermaidTree.expandGroup",
        "title": "Expand in Diagram",
        "category": "Mermaid Tree",
        "icon": "$(unfold)"
      },
      {
        "command": "mermaidTree.collapseAllInDiagram",
        "title": "Collapse All in Diagram",
        "category": "Mermaid Tree"
      },
      {
        "command": "mermaidTree.expandAllInDiagram",
        "title": "Expand All in Diagram",
        "category": "Mermaid Tree"
      },
      {
        "command": "mermaidTree.renameItem",
        "title": "Rename…",
        "category": "Mermaid Tree",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mermaidTree.openPreview",
          "when": "resourceLangId == mermaid",
          "group": "mermaid@1"
        },
        {
          "command": "mermaidTree.showTree",
          "when": "resourceLangId == mermaid",
          "group": "mermaid@2"
        },
        {
          "command": "mermaidTree.showInDiagram",
          "when": "resourceLangId == mermaid",
          "group": "mermaid@3"
        },
        {
          "command": "mermaidTree.combineClassDiagrams",
          "when": "resourceLangId == mermaid && mermaidTree.classDiagram",
          "group": "mermaid@4"
        },
        {
          "command": "mermaidTree.changeParticipant",
          "when": "resourceLangId == mermaid && mermaidTree.sequence",
          "group": "1_modification@8"
        },
        {
          "command": "mermaidTree.fixAllNaming",
          "when": "resourceLangId == mermaid && config.mermaidTree.namingStyle != off",
          "group": "1_modification@9"
        }
      ],
      "editor/title": [
        {
          "command": "mermaidTree.openPreview",
          "when": "resourceLangId == mermaid",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "mermaidTree.openPreview",
          "when": "view == mermaidTree.structure",
          "group": "navigation@1"
        },
        {
          "command": "mermaidTree.showAll",
          "when": "view == mermaidTree.structure",
          "group": "navigation@2"
        },
        {
          "command": "mermaidTree.search",
          "when": "view == mermaidTree.structure",
          "group": "navigation@3"
        },
        {
          "command": "mermaidTree.clearSearch",
          "when": "view == mermaidTree.structure && mermaidTree.searching",
          "group": "navigation@4"
        },
        {
          "command": "mermaidTree.openSettings",
          "when": "view == mermaidTree.structure",
          "group": "navigation@9"
        }
      ],
      "webview/context": [
        {
          "command": "mermaidTree.collapseAllInDiagram",
          "when": "webviewId == 'mermaidTree.preview' && mermaidTreeGroups",
          "group": "1_collapse@1"
        },
        {
          "command": "mermaidTree.expandAllInDiagram",
          "when": "webviewId == 'mermaidTree.preview' && mermaidTreeGroups",
          "group": "1_collapse@2"
        }
      ],
      "view/item/context": [
        {
          "command": "mermaidTree.showInDiagram",
          "when": "view == mermaidTree.structure && viewItem =~ /^(node|edge|subgraph|subgraphCollapsed|block|blockCollapsed|section|sectionCollapsed)$/"
        },
        {
          "command": "mermaidTree.focusNeighbors",
          "when": "view == mermaidTree.structure && viewItem =~ /^(node|subgraph|subgraphCollapsed)$/",
          "group": "inline"
        },
        {
          "command": "mermaidTree.showClosest",
          "when": "view == mermaidTree.structure && viewItem =~ /^(node|subgraph|subgraphCollapsed)$/",
          "group": "1_focus@1"
        },
        {
          "command": "mermaidTree.showChain",
          "when": "view == mermaidTree.structure && viewItem =~ /^(node|subgraph|subgraphCollapsed)$/",
          "group": "1_focus@2"
        },
        {
          "command": "mermaidTree.collapseGroup",
          "when": "view == mermaidTree.structure && viewItem =~ /^(section|block)$/",
          "group": "inline"
        },
        {
          "command": "mermaidTree.collapseGroup",
          "when": "view == mermaidTree.structure && viewItem =~ /^(subgraph|section|block)$/"
        },
        {
          "command": "mermaidTree.expandGroup",
          "when": "view == mermaidTree.structure && viewItem =~ /^(sectionCollapsed|blockCollapsed)$/",
          "group": "inline"
        },
        {
          "command": "mermaidTree.expandGroup",
          "when": "view == mermaidTree.structure && viewItem =~ /^(subgraphCollapsed|sectionCollapsed|blockCollapsed)$/"
        },
        {
          "command": "mermaidTree.hideItem",
          "when": "view == mermaidTree.structure && viewItem =~ /^(node|edge|subgraph|subgraphCollapsed|box|block|blockCollapsed)$/"
        },
        {
          "command": "mermaidTree.renameItem",
          "when": "view == mermaidTree.structure && viewItem =~ /^(node|subgraph|subgraphCollapsed)$/",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "mermaidTree.showInDiagram",
          "when": "editorLangId == mermaid"
        },
        {
          "command": "mermaidTree.collapseAllInDiagram",
          "when": "editorLangId == mermaid"
        },
        {
          "command": "mermaidTree.expandAllInDiagram",
          "when": "editorLangId == mermaid"
        },
        {
          "command": "mermaidTree.changeParticipant",
          "when": "editorLangId == mermaid && mermaidTree.sequence"
        },
        {
          "command": "mermaidTree.fixAllNaming",
          "when": "editorLangId == mermaid"
        },
        {
          "command": "mermaidTree.fixNaming",
          "when": "false"
        },
        {
          "command": "mermaidTree.fixLookalike",
          "when": "false"
        },
        {
          "command": "mermaidTree.useName",
          "when": "false"
        },
        {
          "command": "mermaidTree.ownStateName",
          "when": "false"
        },
        {
          "command": "mermaidTree.collapseGroup",
          "when": "false"
        },
        {
          "command": "mermaidTree.expandGroup",
          "when": "false"
        },
        {
          "command": "mermaidTree.focusNeighbors",
          "when": "false"
        },
        {
          "command": "mermaidTree.showChain",
          "when": "false"
        },
        {
          "command": "mermaidTree.showClosest",
          "when": "false"
        },
        {
          "command": "mermaidTree.hideItem",
          "when": "false"
        },
        {
          "command": "mermaidTree.renameItem",
          "when": "false"
        },
        {
          "command": "mermaidTree.clearSearch",
          "when": "mermaidTree.searching"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test test/*.test.js",
    "test:unit": "tsc -p . && node --test test/parser.test.js test/state.test.js test/zoom.test.js test/labels.test.js test/language.test.js test/diagnostics.test.js test/tree.test.js test/syntax.test.js test/collapse.test.js test/sequence.test.js test/class.test.js test/rename.test.js test/rename.property.test.js test/edgeClick.test.js test/hiddenStore.test.js test/naming.test.js test/participant.test.js test/completion.test.js test/grammar.test.js test/semantic.test.js test/lookalike.test.js test/mergeClass.test.js test/showInDiagram.test.js test/chain.test.js test/sharedStates.test.js",
    "test:contract": "tsc -p . && node --test test/mermaid.contract.test.js test/state.contract.test.js test/mermaid.parse.test.js test/collapse.contract.test.js test/sequence.contract.test.js test/class.contract.test.js test/export.contract.test.js test/preview.contract.test.js test/labels.contract.test.js test/edgeClick.contract.test.js test/naming.contract.test.js test/participant.contract.test.js test/lookalike.contract.test.js test/mergeClass.contract.test.js",
    "package": "tsc -p . && vsce package"
  },
  "dependencies": {
    "mermaid": "12.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.138.0",
    "@vscode/vsce": "4.1.0",
    "playwright-core": "1.64.0",
    "typescript": "6.0.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thmosa/mermaidplugin.git"
  }
}

{
  "name": "mermaid-tree",
  "displayName": "Mermaid Tree",
  "description": "Structure tree and live preview for Mermaid diagrams: hide, show and collapse parts of flowcharts, state, sequence and class diagrams.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:mermaid"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mermaid",
        "scopeName": "source.mermaid",
        "path": "./syntaxes/mermaid.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[mermaid]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.autoIndent": "full"
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mermaidTree",
          "title": "Mermaid Tree",
          "icon": "media/tree.svg"
        }
      ]
    },
    "views": {
      "mermaidTree": [
        {
          "id": "mermaidTree.structure",
          "name": "Mermaid Structure"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mermaidTree.structure",
        "contents": "Open a .mmd or .mermaid file to see the diagram structure.\n[Preview Diagram](command:mermaidTree.openPreview)"
      }
    ],
    "commands": [
      {
        "command": "mermaidTree.openPreview",
        "title": "Preview Diagram",
        "category": "Mermaid Tree",
        "icon": "$(open-preview)"
      },
      {
        "command": "mermaidTree.showTree",
        "title": "View Tree",
        "category": "Mermaid Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "mermaidTree.showAll",
        "title": "Show All",
        "category": "Mermaid Tree",
        "icon": "$(eye)"
      },
      {
        "command": "mermaidTree.focusNeighbors",
        "title": "Show Only This and Its Neighbors",
        "category": "Mermaid Tree",
        "icon": "$(target)"
      },
      {
        "command": "mermaidTree.hideItem",
        "title": "Hide",
        "category": "Mermaid Tree",
        "icon": "$(eye-closed)"
      },
      {
        "command": "mermaidTree.collapseGroup",
        "title": "Collapse in Diagram",
        "category": "Mermaid Tree",
        "icon": "$(fold)"
      },
      {
        "command": "mermaidTree.expandGroup",
        "title": "Expand in Diagram",
        "category": "Mermaid Tree",
        "icon": "$(unfold)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mermaidTree.openPreview",
          "when": "resourceLangId == mermaid",
          "group": "mermaid@1"
        },
        {
          "command": "mermaidTree.showTree",
          "when": "resourceLangId == mermaid",
          "group": "mermaid@2"
        }
      ],
      "editor/title": [
        {
          "command": "mermaidTree.openPreview",
          "when": "resourceLangId == mermaid",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "mermaidTree.openPreview",
          "when": "view == mermaidTree.structure",
          "group": "navigation@1"
        },
        {
          "command": "mermaidTree.showAll",
          "when": "view == mermaidTree.structure",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "mermaidTree.focusNeighbors",
          "when": "view == mermaidTree.structure && viewItem == node",
          "group": "inline"
        },
        {
          "command": "mermaidTree.focusNeighbors",
          "when": "view == mermaidTree.structure && viewItem == node"
        },
        {
          "command": "mermaidTree.collapseGroup",
          "when": "view == mermaidTree.structure && viewItem =~ /^(subgraph|section)$/",
          "group": "inline"
        },
        {
          "command": "mermaidTree.collapseGroup",
          "when": "view == mermaidTree.structure && viewItem =~ /^(subgraph|section)$/"
        },
        {
          "command": "mermaidTree.expandGroup",
          "when": "view == mermaidTree.structure && viewItem =~ /^(subgraphCollapsed|sectionCollapsed)$/",
          "group": "inline"
        },
        {
          "command": "mermaidTree.expandGroup",
          "when": "view == mermaidTree.structure && viewItem =~ /^(subgraphCollapsed|sectionCollapsed)$/"
        },
        {
          "command": "mermaidTree.hideItem",
          "when": "view == mermaidTree.structure && viewItem =~ /^(node|edge|subgraph|subgraphCollapsed|box)$/"
        }
      ],
      "commandPalette": [
        {
          "command": "mermaidTree.collapseGroup",
          "when": "false"
        },
        {
          "command": "mermaidTree.expandGroup",
          "when": "false"
        },
        {
          "command": "mermaidTree.focusNeighbors",
          "when": "false"
        },
        {
          "command": "mermaidTree.hideItem",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test test/*.test.js",
    "test:unit": "tsc -p . && node --test test/parser.test.js test/state.test.js test/zoom.test.js test/labels.test.js test/language.test.js test/diagnostics.test.js test/tree.test.js test/syntax.test.js test/collapse.test.js test/sequence.test.js test/class.test.js",
    "test:contract": "tsc -p . && node --test test/mermaid.contract.test.js test/state.contract.test.js test/mermaid.parse.test.js test/collapse.contract.test.js test/sequence.contract.test.js test/class.contract.test.js",
    "package": "tsc -p . && vsce package"
  },
  "dependencies": {
    "mermaid": "12.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.138.0",
    "@vscode/vsce": "4.1.0",
    "playwright-core": "1.64.0",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thmosa/mermaidplugin.git"
  }
}
